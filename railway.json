{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd admin_dashboard && npm install && npm run build",
    "watchPatterns": ["admin_dashboard/**"]
  },
  "deploy": {
    "startCommand": "cd admin_dashboard && npx serve -s dist",
    "restartPolicyType": "ON_FAILURE",
    "healthCheckPath": "/"
  }
}
