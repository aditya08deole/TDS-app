rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if user has admin role
    function isAdmin() {
      return isAuth() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Devices: Read for all users, Write only for admins
    match /devices/{deviceId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Sensor Data: Read for all users, No direct writes (only via system/functions)
    match /sensor_data/{docId} {
      allow read: if isAuth();
      allow write: if false; 
    }

    // Alerts: Read for all users, Write only for system/admins (or status updates for users)
    match /alerts/{alertId} {
      allow read: if isAuth();
      allow update: if isAdmin(); // Only admins can acknowledge/close alerts (prevents unauthorized acknowledgement)
      allow create, delete: if isAdmin();
    }

    // Users Collection: Users can read/write their own profiles
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}
