# EvaraTDS Admin Dashboard - Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit real values to git!

# Firebase Configuration
VITE_FIREBASE_API_KEY=xxx_your_firebase_api_key_here_xxx
VITE_FIREBASE_AUTH_DOMAIN=xxx_your_auth_domain_xxx
VITE_FIREBASE_PROJECT_ID=xxx_your_project_id_xxx
VITE_FIREBASE_STORAGE_BUCKET=xxx_your_storage_bucket_xxx
VITE_FIREBASE_MESSAGING_SENDER_ID=xxx_your_sender_id_xxx
VITE_FIREBASE_APP_ID=xxx_your_app_id_xxx
VITE_VAPID_PUBLIC_KEY=xxx_your_vapid_key_xxx

# Backend API
VITE_BACKEND_URL=http://localhost:5000

# Feature Flags
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
