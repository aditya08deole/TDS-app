# Redis
REDIS_URL=redis://localhost:6379

# Firebase
FIREBASE_PROJECT_ID=evaratds
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Server
PORT=5000
NODE_ENV=development

# Sync
SYNC_INTERVAL_HOURS=1
ENABLE_EVENT_SYNC=true

# Twilio WhatsApp (Optional)
TWILIO_ACCOUNT_SID=xxx_your_account_sid_xxx
TWILIO_AUTH_TOKEN=xxx_your_auth_token_xxx
TWILIO_WHATSAPP_FROM=+1234567890

# Public URL for Twilio webhook signature validation (Fix #15)
# Set to the full public URL where this backend is hosted
# Example: https://api.evaratech.com
PUBLIC_URL=https://your-backend-url.com

# CORS — Fix #34: Must be explicitly set to true to allow all origins.
# Leave unset (or set to false) in production to enforce CORS_ORIGINS whitelist.
CORS_ALL_ORIGINS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
