{
  "name": "tds-backend",
  "version": "1.0.1",
  "description": "Express backend for TDS-APP with Redis mirroring",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
